{
  "name": "sports-oracle",
  "display_name": "Sports Oracle",
  "version": "1.0.0",
  "description": "Real-time sports data oracle covering 10 sports with injuries, live scores, schedules, standings and team data. Wraps the Sports Oracle API (79 REST endpoints, 18 MCP tools).",
  "author": "SarutobiSasuke8",
  "repository": "https://github.com/SarutobiSasuke8/sports-oracle-teneo-agent",
  "license": "MIT",
  "agent_type": "mcp",
  "keywords": ["sports", "oracle", "nba", "nhl", "mlb", "nfl", "f1", "soccer", "tennis", "mma", "scores", "injuries", "betting-data"],
  "endpoints": {
    "http": "http://localhost:8080",
    "mcp": "https://sports-oracle.vercel.app/api/mcp"
  },
  "transport": {
    "type": "http",
    "mcp_supported": true
  },
  "payment": {
    "protocol": "x402",
    "currency": "USDC",
    "default_price": "0.001"
  },
  "env": {
    "SPORTS_ORACLE_KEY": {
      "description": "Sports Oracle API key sent as X-Oracle-Key header. Defaults to the sandbox key; live access requires a staked key.",
      "required": false,
      "default": "sk_test_886492645fd15c41a37c4101c8b616a2"
    },
    "PORT": {
      "description": "Port the agent HTTP service listens on.",
      "required": false,
      "default": "8080"
    }
  },
  "commands": [
    {
      "name": "nba",
      "description": "NBA data: injuries, scores, schedule, standings, teams.",
      "price": "0.001",
      "parameters": [
        {
          "name": "resource",
          "type": "string",
          "required": true,
          "description": "Resource to fetch",
          "enum": ["injuries", "scores", "schedule", "standings", "teams"]
        }
      ]
    },
    {
      "name": "nhl",
      "description": "NHL data: injuries, scores, schedule, standings, teams.",
      "price": "0.001",
      "parameters": [
        {
          "name": "resource",
          "type": "string",
          "required": true,
          "description": "Resource to fetch",
          "enum": ["injuries", "scores", "schedule", "standings", "teams"]
        }
      ]
    },
    {
      "name": "mlb",
      "description": "MLB data: injuries, scores, schedule, standings, teams.",
      "price": "0.001",
      "parameters": [
        {
          "name": "resource",
          "type": "string",
          "required": true,
          "description": "Resource to fetch",
          "enum": ["injuries", "scores", "schedule", "standings", "teams"]
        }
      ]
    },
    {
      "name": "nfl",
      "description": "NFL data: injuries, scores, schedule, standings, teams.",
      "price": "0.001",
      "parameters": [
        {
          "name": "resource",
          "type": "string",
          "required": true,
          "description": "Resource to fetch",
          "enum": ["injuries", "scores", "schedule", "standings", "teams"]
        }
      ]
    },
    {
